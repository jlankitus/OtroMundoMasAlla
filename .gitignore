# ── Build output ──────────────────────────────────────────────
build/
out/
cmake-build-*/
CMakeUserPresets.json

# ── IDE / editor ──────────────────────────────────────────────
.vs/
.vscode/
.idea/
*.user
*.suo
*.sln
*.vcxproj*

# ── Compiler / linker droppings ───────────────────────────────
*.obj
*.o
*.lib
*.a
*.pdb
*.ilk
*.exp
*.dll
*.so
*.dylib
*.exe

# ── Simulation output ─────────────────────────────────────────
# A run is reproducible from its scenario plus its seed, so we
# version the inputs and never the outputs. Note we do NOT ignore
# *.csv globally — planetary data under data/ is an input and
# belongs in the repository.
runs/
telemetry/
frames/
qa_*/
qa_*.png
temporal_qa/
*.omma-replay

# ── OS ────────────────────────────────────────────────────────
Thumbs.db
.DS_Store

# Unity generates these when apps/omma-unity is opened as a project.
# ProjectSettings/ and Packages/ ARE committed; caches and IDE files are not.
apps/omma-unity/Library/
apps/omma-unity/Temp/
apps/omma-unity/Logs/
apps/omma-unity/UserSettings/
apps/omma-unity/obj/
apps/omma-unity/*.csproj
apps/omma-unity/*.sln
apps/omma-unity/Assets/Plugins/x86_64/*.dll
